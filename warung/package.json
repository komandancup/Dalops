{
  "name": "warung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run tests/lib tests/api tests/ui",
    "test:emu": "firebase emulators:exec --only auth,firestore \"vitest run --no-file-parallelism tests/rules tests/data\"",
    "e2e": "firebase emulators:exec --only auth,firestore \"tsx scripts/seed-emulator.ts && playwright test tests/e2e --trace off\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.5.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vitest": "^5.1.1"
  }
}
